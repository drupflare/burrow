diff -ur a/m3_exec.h b/m3_exec.h
--- a/m3_exec.h	2026-09-15 19:43:46
+++ b/m3_exec.h	2026-09-15 19:44:20
@@ -381,6 +381,40 @@
 d_m3FoldOp_f           (f64, Divide,       M3_OPER_A, /, canon_nan_f64)
 #endif
 
+#  if d_m3FoldLoopBackEdge
+// A counted loop closes on "advance the local, test it, branch back". The advance is already
+// a destination-folded op writing the local's slot, and the branch reads the same value out of
+// the register, so one operation can do all three. The back edge returns the loop id to
+// op_Loop's own do-while rather than jumping, which is why it needs its own variants.
+#    define d_m3FoldLoopOp(TYPE, NAME, OP, ...)         \
+d_m3Op(TYPE##_##NAME##_rs_fl)                           \
+{                                                       \
+    TYPE   operand = slot (TYPE);                       \
+    TYPE * dest    = slot_ptr (TYPE);                   \
+    void * loopId  = immediate (void*);                 \
+    TYPE   result;                                      \
+    OP((result), operand, ((TYPE) _r0), ##__VA_ARGS__); \
+    * dest = result;  _r0 = result;                     \
+    if (result) return loopId;                          \
+    nextOp ();                                          \
+}                                                       \
+d_m3Op(TYPE##_##NAME##_ss_fl)                           \
+{                                                       \
+    TYPE   operand2 = slot (TYPE);                      \
+    TYPE   operand1 = slot (TYPE);                      \
+    TYPE * dest     = slot_ptr (TYPE);                  \
+    void * loopId   = immediate (void*);                \
+    TYPE   result;                                      \
+    OP((result), operand1, operand2, ##__VA_ARGS__);    \
+    * dest = result;  _r0 = result;                     \
+    if (result) return loopId;                          \
+    nextOp ();                                          \
+}
+
+d_m3FoldLoopOp(i32, Add,      M3_FUNC, OP_ADD_32)
+d_m3FoldLoopOp(i32, Subtract, M3_FUNC, OP_SUB_32)
+#  endif // d_m3FoldLoopBackEdge
+
 #endif // d_m3FoldSetLocal
 
 #if d_m3HasFloat
