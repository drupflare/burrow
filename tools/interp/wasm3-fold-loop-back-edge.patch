+#if d_m3FoldLoopBackEdge
+// when a destination-folded add or subtract wrote a local's slot and its result is still on top
+// in _r0, return the variant that also tests it and takes the loop's back edge
+static
+IM3Operation GetLoopFoldOp (IM3Compilation o)
+{
+    if (not o->loopFoldPC or o->loopFoldForm >= 4) {
+        return NULL;
+    }
+
+    if (not IsStackTopInRegister(o) or GetStackTopIndex(o) != (i16)o->loopFoldStackIndex) {
+        return NULL;
+    }
+
+    switch (o->loopFoldOpcode) {
+    case 0x6a:  // i32.add
+        return o->loopFoldForm == 0 ? op_i32_Add_rs_fl      : (o->loopFoldForm == 2 ? op_i32_Add_ss_fl      : NULL);
+    case 0x6b:  // i32.sub
+        return o->loopFoldForm == 0 ? op_i32_Subtract_rs_fl : (o->loopFoldForm == 2 ? op_i32_Subtract_ss_fl : NULL);
